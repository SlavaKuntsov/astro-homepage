---
import AntiFouc from '@/components/AntiFouc.astro';
import { DEFAULT_OG_IMAGE } from '@/consts';
import { translations } from '@/i18n';
import type { Locale } from '@/lib/i18n';
import { OG_LOCALE, localeAlternates } from '@/lib/seo';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description: string;
	lang: Locale;
	image?: string;
	/** The page's Open Graph type; a Project detail page is an `article`. */
	ogType?: 'website' | 'article';
	/** Set when the page paints italic body text (the home greeting does). */
	preloadItalic?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	lang,
	image = DEFAULT_OG_IMAGE,
	ogType = 'website',
	preloadItalic = false,
} = Astro.props;

const t = translations[lang];
const otherLocale: Locale = lang === 'ru' ? 'en' : 'ru';
const alternates = localeAlternates(Astro.url.pathname);
const ogImage = new URL(image, Astro.site);

// Preload only the subsets the page can paint in its Locale. Both families are
// variable fonts, so one file per subset/style covers every weight. Italic is
// opt-in: without the preload the browser discovers it late and swaps it in
// after first paint, visibly shifting the line.
const subsets = lang === 'ru' ? ['latin', 'cyrillic'] : ['latin'];
const normalPreload: Array<{ subset: string; style: string }> = subsets.map(
	subset => ({ subset, style: 'normal' })
);
const bodyPreload = preloadItalic
	? [
			...normalPreload,
			...subsets.map(subset => ({ subset, style: 'italic' })),
		]
	: normalPreload;
---

<head>
	<!-- charset must stay within the first 1024 bytes, so it leads the head. -->
	<meta charset='utf-8' />

	<!-- Resolve the Theme before anything paints (ADR-0003). -->
	<AntiFouc />

	<!-- Global Metadata -->
	<meta name='viewport' content='width=device-width,initial-scale=1' />
	<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
	<meta name='generator' content={Astro.generator} />

	<!--
		Self-hosted by the Astro Fonts API. `<Font preload>` emits preload links
		with the correct `font/woff2` MIME type, and Astro's optimized fallbacks
		keep the swap from shifting the layout.
	-->
	<Font cssVariable='--font-comfortaa' preload={normalPreload} />
	<Font cssVariable='--font-inter' preload={bodyPreload} />

	<!--
		Canonical URL and Locale alternates (ADR-0005): every page names its ru/en
		counterparts so crawlers serve the right Locale, with `x-default` pointing
		at the default Locale. The mapping is the Locale switcher's, so the two
		can never disagree.
	-->
	<link rel='canonical' href={canonicalURL} />
	{alternates.map(({ hreflang, path }) => (
		<link rel='alternate' hreflang={hreflang} href={new URL(path, Astro.site)} />
	))}

	<!-- Primary Meta Tags -->
	<title>{title}</title>
	<meta name='title' content={title} />
	<meta name='description' content={description} />

	<!-- Open Graph -->
	<meta property='og:type' content={ogType} />
	<meta property='og:site_name' content={t.meta.siteName} />
	<meta property='og:url' content={canonicalURL} />
	<meta property='og:title' content={title} />
	<meta property='og:description' content={description} />
	<meta property='og:image' content={ogImage} />
	<meta property='og:locale' content={OG_LOCALE[lang]} />
	<meta property='og:locale:alternate' content={OG_LOCALE[otherLocale]} />

	<!-- Twitter -->
	<meta name='twitter:card' content='summary' />
	<meta name='twitter:title' content={title} />
	<meta name='twitter:description' content={description} />
	<meta name='twitter:image' content={ogImage} />

	<ClientRouter />
</head>
