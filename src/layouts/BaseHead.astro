---
import AntiFouc from '@/components/AntiFouc.astro';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description: string;
	lang: 'ru' | 'en';
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, lang, image = '/favicon.svg' } = Astro.props;

// Preload only the subsets the page can paint in its Locale. Both families are
// variable fonts, so one file per subset/style covers every weight; italic is
// left on-demand because only the home greeting uses it.
const preload: Array<{ subset: string; style: string }> =
	lang === 'ru'
		? [
				{ subset: 'latin', style: 'normal' },
				{ subset: 'cyrillic', style: 'normal' },
			]
		: [{ subset: 'latin', style: 'normal' }];
---

<head>
	<!-- charset must stay within the first 1024 bytes, so it leads the head. -->
	<meta charset='utf-8' />

	<!-- Resolve the Theme before anything paints (ADR-0003). -->
	<AntiFouc />

	<!-- Global Metadata -->
	<meta name='viewport' content='width=device-width,initial-scale=1' />
	<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
	<meta name='generator' content={Astro.generator} />

	<!--
		Self-hosted by the Astro Fonts API. `<Font preload>` emits preload links
		with the correct `font/woff2` MIME type, and Astro's optimized fallbacks
		keep the swap from shifting the layout.
	-->
	<Font cssVariable='--font-comfortaa' preload={preload} />
	<Font cssVariable='--font-inter' preload={preload} />

	<!-- Canonical URL -->
	<link rel='canonical' href={canonicalURL} />

	<!-- Primary Meta Tags -->
	<title>{title}</title>
	<meta name='title' content={title} />
	<meta name='description' content={description} />

	<!-- Open Graph / Facebook -->
	<meta property='og:type' content='website' />
	<meta property='og:url' content={Astro.url} />
	<meta property='og:title' content={title} />
	<meta property='og:description' content={description} />
	<meta property='og:image' content={new URL(image, Astro.url)} />

	<ClientRouter />
</head>
