---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import { translations } from '@/i18n';
import type { Locale } from '@/lib/i18n';
import '@/styles/global.css';
import BaseHead from './BaseHead.astro';

interface Props {
	title: string;
	description: string;
	/** The Locale of the page; the shell renders its chrome in this Locale. */
	lang: Locale;
	/** The page's social-share image; defaults to the Site image in `BaseHead`. */
	image?: string;
	/** The page's Open Graph type; a Project detail page is an `article`. */
	ogType?: 'website' | 'article';
	/** Set when the page paints italic body text (the home greeting does). */
	preloadItalic?: boolean;
}

const { title, description, lang, image, ogType, preloadItalic } = Astro.props;
const t = translations[lang];
---

<!doctype html>
<html lang={lang}>
	<BaseHead
		title={title}
		description={description}
		image={image}
		ogType={ogType}
		lang={lang}
		preloadItalic={preloadItalic}
	/>
	<body class='flex min-h-dvh flex-col bg-background text-foreground'>
		<a class='skip-link' href='#main'>{t.a11y.skipToContent}</a>

		<!-- Persisted per Locale: same-Locale navigation keeps them, a Locale
		     switch replaces them with the correct server-rendered labels. -->
		<Header t={t} lang={lang} persistKey={`site-header-${lang}`} />

		<main
			id='main'
			class='mx-auto w-full max-w-column flex-1 px-gutter py-section'
			data-content-column
		>
			<slot />
		</main>

		<Footer t={t} persistKey={`site-footer-${lang}`} />

		<ScrollReveal />
	</body>
</html>
