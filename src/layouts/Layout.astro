---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import en from '@/i18n/en';
import ru from '@/i18n/ru';
import '@/styles/global.css';
import type { Translation } from '@/types/Translation';
import BaseHead from './BaseHead.astro';

interface Props {
	title: string;
	description: string;
	/** The Locale of the page; the shell renders its chrome in this Locale. */
	lang: 'ru' | 'en';
	image?: string;
	/** Set when the page paints italic body text (the home greeting does). */
	preloadItalic?: boolean;
}

const { title, description, lang, image, preloadItalic } = Astro.props;
const t: Translation = lang === 'ru' ? ru : en;
---

<!doctype html>
<html lang={lang}>
	<BaseHead
		title={title}
		description={description}
		image={image}
		lang={lang}
		preloadItalic={preloadItalic}
	/>
	<body class='flex min-h-dvh flex-col bg-background text-foreground'>
		<a class='skip-link' href='#main'>{t.a11y.skipToContent}</a>

		<!-- Persisted per Locale: same-Locale navigation keeps them, a Locale
		     switch replaces them with the correct server-rendered labels. -->
		<Header t={t} persistKey={`site-header-${lang}`} />

		<main
			id='main'
			class='mx-auto w-full max-w-content flex-1 px-gutter py-section'
		>
			<slot />
		</main>

		<Footer t={t} persistKey={`site-footer-${lang}`} />
	</body>
</html>
