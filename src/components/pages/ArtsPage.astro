---
// The Arts gallery page (ticket #10): the `arts` collection's Artworks as a
// grid that opens a keyboard-accessible lightbox (`ArtsGallery`). The order is
// `arts/order.json` (ADR-0009); the Locale comes from the collection folder, so
// the RU and EN files pair by slug.
import ArtsGallery from '@/components/ArtsGallery.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { translations } from '@/i18n';
import Layout from '@/layouts/Layout.astro';
import { orderedArts } from '@/lib/arts';
import { entriesForLocale } from '@/lib/collection';
import type { Locale } from '@/lib/i18n';
import { getCollection } from 'astro:content';

interface Props {
	/** The Locale this page renders in. */
	lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang];
const arts = orderedArts(entriesForLocale(await getCollection('arts'), lang));
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} lang={lang}>
	<h1 class='text-3xl font-semibold'>{t.arts.heading}</h1>

	<ArtsGallery arts={arts} t={t} />
</Layout>
