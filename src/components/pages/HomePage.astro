---
// The home page (ticket #12): the Site's CV, assembled from the content
// collections — never hardcoded. A recruiter sees the hero carousel first, then
// the hero (name, position, one-line pitch, avatar), the resume sections
// (about, experience highlights, education, skills) and the contacts. The
// carousel and every section are collection-driven, and the page loads with no
// Flash (`e2e/theme.spec.ts`, `e2e/home.spec.ts`).
import ArtsCarousel from '@/components/ArtsCarousel.astro';
import ContactsSection from '@/components/ContactsSection.astro';
import EducationSection from '@/components/EducationSection.astro';
import ExperienceHighlights from '@/components/ExperienceHighlights.astro';
import Heading from '@/components/Heading.astro';
import MainContent from '@/components/MainContent.astro';
import SkillsSection from '@/components/SkillsSection.astro';
import { translations } from '@/i18n';
import Layout from '@/layouts/Layout.astro';
import { orderedArts } from '@/lib/arts';
import { entriesForLocale } from '@/lib/collection';
import { orderedEducation } from '@/lib/education';
import type { Locale } from '@/lib/i18n';
import { getCollection } from 'astro:content';

interface Props {
	/** The Locale this page renders in. */
	lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang];
const experience = entriesForLocale(await getCollection('experience'), lang);
const education = orderedEducation(
	entriesForLocale(await getCollection('education'), lang)
);
const skills = await getCollection('skills');
const arts = orderedArts(entriesForLocale(await getCollection('arts'), lang));

/**
 * One page column, used by the hero group and by the reveal container below it,
 * so the two cannot drift apart in gap or alignment when either changes.
 */
const column = 'flex w-full flex-col items-start gap-7 sm:gap-8';
---

<Layout
	title={t.meta.home.title}
	description={t.meta.home.description}
	lang={lang}
	preloadItalic
>
	<div class={column}>
		<ArtsCarousel arts={arts} t={t} />
		<Heading t={t} />

		<!--
			The content sections opt into the Site-wide scroll reveal (ticket #30).
			The hero above is deliberately outside this container: the carousel,
			greeting, name, and avatar must be fully painted and unmoved on the
			first frame, because a faded or shifted hero reads as a first-load
			defect of the same family as the Flash.
		-->
		<div class={column} data-reveal>
			<MainContent t={t} />
			<ExperienceHighlights entries={experience} lang={lang} t={t} />
			<EducationSection entries={education} t={t} />
			<SkillsSection entries={skills} t={t} />
			<ContactsSection t={t} />
		</div>
	</div>
</Layout>
