---
import ContactsSection from '@/components/ContactsSection.astro';
import ExperienceHighlights from '@/components/ExperienceHighlights.astro';
import Heading from '@/components/Heading.astro';
import MainContent from '@/components/MainContent.astro';
import SkillsSection from '@/components/SkillsSection.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { translations } from '@/i18n';
import Layout from '@/layouts/Layout.astro';
import { entriesForLocale } from '@/lib/collection';
import type { Locale } from '@/lib/i18n';
import { getCollection } from 'astro:content';

interface Props {
	/** The Locale this page renders in. */
	lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang];
const experience = entriesForLocale(await getCollection('experience'), lang);
const skills = await getCollection('skills');
---

<Layout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	lang={lang}
	preloadItalic
>
	<div
		class='mx-auto flex w-full max-w-prose flex-col items-start gap-7 sm:gap-8'
	>
		<Heading t={t} />
		<MainContent t={t} />
		<ExperienceHighlights entries={experience} lang={lang} t={t} />
		<SkillsSection entries={skills} t={t} />
		<ContactsSection t={t} />
	</div>
</Layout>