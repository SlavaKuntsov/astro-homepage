---
// The Projects index (ticket #9): the showcased work as collection-driven
// cards, featured projects first and the rest in `projects/order.json` order
// (ADR-0009). Each card is `ProjectCard`, shared with the home page's featured
// block so the index and the preview render a Project the same way.
//
// The list opts into the Site-wide scroll reveal (ticket #34): the cards below
// the fold fade and rise into place with the row stagger, while the cards on
// screen at load are painted at full strength on the first frame.
import ProjectCard from '@/components/ProjectCard.astro';
import { translations } from '@/i18n';
import Layout from '@/layouts/Layout.astro';
import { entriesForLocale } from '@/lib/collection';
import { enrichProjects } from '@/lib/enrichment';
import type { Locale } from '@/lib/i18n';
import {
	mergeProject,
	orderedProjects,
	publishedProjects,
} from '@/lib/projects';
import { getCollection } from 'astro:content';

interface Props {
	/** The Locale this page renders in. */
	lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang];
const entries = orderedProjects(
	publishedProjects(
		entriesForLocale(await getCollection('projects'), lang).map(entry =>
			mergeProject(entry)
		)
	)
);
const projects = await enrichProjects(entries);
---

<Layout
	title={t.meta.projects.title}
	description={t.meta.projects.description}
	lang={lang}
>
	<h1 class='text-3xl font-semibold'>{t.projects.heading}</h1>

	<ul
		class='mt-8 grid gap-6 sm:grid-cols-2'
		data-projects-list
		data-reveal
	>
		{projects.map(({ entry, meta }) => (
			<ProjectCard entry={entry} meta={meta} lang={lang} t={t} />
		))}
	</ul>
</Layout>
