---
// A compact, collection-driven summary of the most recent Experience entries,
// built to be dropped into the home page (ticket #12). It reads the same
// `experience` collection and date formatting as the full timeline, so home
// and `/experience` can never drift apart.
import { localizePath } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import {
	formatPeriod,
	recentEntries,
	slugOfEntryId,
	type ExperienceEntry,
} from '@/lib/experience';
import type { Translation } from '@/types/Translation';

interface Props {
	/** All entries; the block picks the most recent `limit` itself. */
	entries: ExperienceEntry[];
	lang: Locale;
	t: Translation;
	/** How many recent roles to summarise. */
	limit?: number;
}

const { entries, lang, t, limit = 3 } = Astro.props;
const highlights = recentEntries(entries, limit);
const href = localizePath('/experience', lang);
---

{
	highlights.length > 0 && (
		<section class='flex flex-col gap-5' data-experience-highlights>
			<h2 class='font-heading text-2xl font-semibold text-foreground'>
				{t.experience.highlightsHeading}
			</h2>

			<ol class='flex flex-col gap-4'>
				{highlights.map(entry => (
					<li
						class='flex flex-col gap-1 border-l-2 border-border pl-5'
						data-experience-highlight
						data-slug={slugOfEntryId(entry.id)}
					>
						<h3 class='font-heading font-semibold text-foreground'>
							{entry.data.position}
						</h3>
						<p class='text-sm text-muted-foreground'>
							{entry.data.company}
							<span> · {formatPeriod(entry.data, lang, t.experience.present)}</span>
						</p>
					</li>
				))}
			</ol>

			<a
				href={href}
				class='w-fit font-medium text-primary underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary'
			>
				{t.experience.viewAll}
			</a>
		</section>
	)
}