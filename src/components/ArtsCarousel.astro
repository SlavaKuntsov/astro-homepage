---
// The home page's hero gallery: the `arts` collection's Artworks as a
// one-at-a-time carousel, restored from the React `Carousel` the hero used to
// run — but Astro-native (ADR-0002): static markup plus a small vanilla script,
// server-rendered from the collection so it never hardcodes an Artwork and
// shows its first Artwork without JavaScript.
//
// The edge fades sit over the Artwork's own left/right edges, so a sliding
// Artwork dissolves into the page instead of hard-clipping. The previous/next
// controls step outboard of the Artwork and are stacked above the fades
// (`z-20` over `z-10`), so a fade can never paint a control away — the
// occlusion the old hero carousel suffered.
import { Picture } from 'astro:assets';
import type { ArtworkEntry } from '@/lib/arts';
import type { Translation } from '@/types/Translation';

interface Props {
	/** The Artworks, already in authored order (see `orderedArts`). */
	arts: readonly ArtworkEntry[];
	t: Translation;
}

const { arts, t }: Props = Astro.props;
const total = arts.length;
const hasNavigation = total > 1;

const controlClass =
	'inline-flex size-8 cursor-pointer items-center justify-center rounded-full border border-border bg-card/90 text-foreground shadow-sm transition-colors hover:bg-muted';
---

{
	total > 0 && (
		<div
			class='relative flex min-h-80 w-full items-center justify-center'
			data-arts-carousel
		>
			<div
				class='relative w-full sm:max-w-xs'
				role='region'
				aria-roledescription='carousel'
				aria-label={t.arts.gallery}
			>
				<!--
					The fades sit over the Artwork's own edges and blend it into the
					page, so a sliding Artwork dissolves at the sides instead of
					hard-clipping. They must reach past the Artwork's transparent
					padding to the drawing itself, so they are generous — a phone's
					band is wider than the Artwork box, hence the wider fade there.
				-->
				<div
					class='edge-fade pointer-events-none absolute inset-y-0 -left-px z-10 w-32 sm:w-24'
					data-edge-fade
					data-arts-fade='left'
					aria-hidden='true'
				/>
				<div
					class='edge-fade edge-fade-right pointer-events-none absolute inset-y-0 -right-px z-10 w-32 sm:w-24'
					data-edge-fade
					data-arts-fade='right'
					aria-hidden='true'
				/>

				<div
					class='cursor-grab overflow-hidden rounded-2xl active:cursor-grabbing'
					data-arts-viewport
				>
					<div
						class='flex touch-pan-y select-none transition-transform duration-300 ease-out motion-reduce:transition-none'
						style='transform: translateX(0)'
						data-arts-track
					>
						{arts.map((entry, index) => (
							<div
								class='w-full shrink-0 overflow-hidden'
								role='group'
								aria-roledescription='slide'
								aria-label={`${index + 1} / ${total}`}
								data-arts-slide
							>
								<!--
									The Artwork PNGs carry ~20-30% transparent padding on
									every side, so `object-contain` leaves the drawing small
									inside a wide empty margin; the generous edge fades are
									what reach past that padding to dissolve the drawing.

									`Picture` emits an AVIF/WebP set per Artwork at build, so
									the hero downloads a few KB per Artwork instead of the
									350px source PNG. Only the first Artwork is eager — the
									rest load lazily, so first paint fetches one, not six.
								-->
								<Picture
									src={entry.data.image}
									alt={entry.data.title}
									formats={['avif', 'webp']}
									quality='high'
									loading={index === 0 ? 'eager' : 'lazy'}
									draggable='false'
									pictureAttributes={{ class: 'contents' }}
									class='h-80 w-full object-contain sm:h-auto sm:aspect-square'
								/>
							</div>
						))}
					</div>
				</div>

				{hasNavigation && (
					<>
						<button
							type='button'
							class={`absolute left-1 top-1/2 z-20 -translate-y-1/2 sm:-left-12 ${controlClass}`}
							aria-label={t.arts.previous}
							data-arts-carousel-previous
						>
							<svg
								viewBox='0 0 24 24'
								width='18'
								height='18'
								fill='none'
								stroke='currentColor'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
								aria-hidden='true'
							>
								<path d='M15 6l-6 6 6 6' />
							</svg>
						</button>

						<button
							type='button'
							class={`absolute right-1 top-1/2 z-20 -translate-y-1/2 sm:-right-12 ${controlClass}`}
							aria-label={t.arts.next}
							data-arts-carousel-next
						>
							<svg
								viewBox='0 0 24 24'
								width='18'
								height='18'
								fill='none'
								stroke='currentColor'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
								aria-hidden='true'
							>
								<path d='M9 6l6 6-6 6' />
							</svg>
						</button>
					</>
				)}
			</div>
		</div>
	)
}

<script>
	// The carousel is page content, so a client-side navigation replaces it:
	// bind the (new) elements each page load instead of holding a reference.
	// Binding is idempotent, so re-running the script is harmless.
	const CAROUSEL = '[data-arts-carousel]';
	const VIEWPORT = '[data-arts-viewport]';
	const TRACK = '[data-arts-track]';
	const SLIDE = '[data-arts-slide]';
	const PREVIOUS = '[data-arts-carousel-previous]';
	const NEXT = '[data-arts-carousel-next]';

	/** How long each Artwork stays, matching the carousel the hero used to run. */
	const AUTOPLAY_DELAY = 4000;
	/** A drag shorter than this snaps back instead of stepping. */
	const DRAG_THRESHOLD = 40;
	/** A vertical gesture taller than this is the page scrolling, not a slide. */
	const SCROLL_SLOP = 8;

	const reduceMotion = () =>
		window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const bindCarousel = () => {
		const carousel = document.querySelector<HTMLElement>(CAROUSEL);
		if (!carousel || carousel.dataset.carouselBound) return;

		carousel.dataset.carouselBound = 'true';

		const viewport = carousel.querySelector<HTMLElement>(VIEWPORT);
		const track = carousel.querySelector<HTMLElement>(TRACK);
		if (!viewport || !track) return;

		const slides = Array.from(track.querySelectorAll<HTMLElement>(SLIDE));
		const count = slides.length;
		if (count < 2) return;

		const previous = carousel.querySelector<HTMLButtonElement>(PREVIOUS);
		const next = carousel.querySelector<HTMLButtonElement>(NEXT);

		// Clone the ends so wrapping animates: the first Artwork follows the last
		// (and the last precedes the first) instead of the track jumping. The
		// clones carry no `data-arts-slide`, so they are not real slides.
		const cloneOf = (slide: HTMLElement) => {
			const node = slide.cloneNode(true) as HTMLElement;
			node.removeAttribute('data-arts-slide');
			node.setAttribute('data-arts-clone', '');
			node.setAttribute('aria-hidden', 'true');
			return node;
		};
		track.append(cloneOf(slides[0]));
		track.prepend(cloneOf(slides[count - 1]));

		// The track's live position: 0 is the clone of the last Artwork, 1..count
		// are the real ones, and count + 1 is the clone of the first.
		let position = 1;
		let timer: number | undefined;

		const slideWidth = () => viewport.clientWidth;

		/** Paints the Artwork at `position`; `instant` skips the slide transition. */
		const paint = (instant = false) => {
			if (instant) track.style.transition = 'none';
			track.style.transform = `translateX(-${position * 100}%)`;
			if (instant) {
				// Flush the jump before restoring the transition, so the browser
				// does not animate between the old and new positions.
				void track.offsetWidth;
				track.style.transition = '';
			}
		};

		/** Snaps off a clone onto the matching real Artwork. */
		const settle = () => {
			if (position === count + 1) {
				position = 1;
				paint(true);
			} else if (position === 0) {
				position = count;
				paint(true);
			}
		};

		const go = (delta: number) => {
			// A step may follow a wrap that has not settled yet (a fast click or
			// swipe), so land on the real Artwork before moving again.
			settle();
			position += delta;
			paint(false);
			// With reduced motion the transition is off, so `transitionend` never
			// fires: settle now instead.
			if (reduceMotion()) settle();
		};

		const stop = () => {
			if (timer !== undefined) {
				window.clearInterval(timer);
				timer = undefined;
			}
		};

		const start = () => {
			if (timer !== undefined) return;
			// Motion-sensitive visitors get no autoplay; the controls still work.
			if (reduceMotion()) return;

			timer = window.setInterval(() => go(1), AUTOPLAY_DELAY);
		};

		/** A control step: restart the countdown from the Artwork it lands on. */
		const step = (delta: number) => {
			stop();
			go(delta);
			start();
		};

		previous?.addEventListener('click', () => step(-1));
		next?.addEventListener('click', () => step(1));

		// Wrapping lands on a clone; snap to the real Artwork once it has slid in.
		track.addEventListener('transitionend', event => {
			if (event.propertyName === 'transform') settle();
		});

		// Drag or swipe to change Artwork: follow the pointer, then step if it
		// travelled far enough, else snap back. Pointer events cover mouse and
		// touch alike; `touch-pan-y` leaves vertical scrolling to the browser.
		let pointerId: number | null = null;
		let startX = 0;
		let startY = 0;
		let deltaX = 0;

		const endDrag = (cancelled: boolean) => {
			if (pointerId !== null && viewport.hasPointerCapture(pointerId)) {
				viewport.releasePointerCapture(pointerId);
			}
			pointerId = null;
			track.style.transition = '';

			if (!cancelled && Math.abs(deltaX) > DRAG_THRESHOLD) {
				go(deltaX < 0 ? 1 : -1);
			} else {
				paint(false);
			}
		};

		viewport.addEventListener('pointerdown', event => {
			if (event.pointerType === 'mouse' && event.button !== 0) return;

			pointerId = event.pointerId;
			startX = event.clientX;
			startY = event.clientY;
			deltaX = 0;
			stop();
			track.style.transition = 'none';
			viewport.setPointerCapture(event.pointerId);
		});

		viewport.addEventListener('pointermove', event => {
			if (event.pointerId !== pointerId) return;

			const dx = event.clientX - startX;
			const dy = event.clientY - startY;

			if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > SCROLL_SLOP) {
				endDrag(true);
				return;
			}

			deltaX = dx;
			track.style.transform = `translateX(${-position * slideWidth() + dx}px)`;
		});

		viewport.addEventListener('pointerup', event => {
			if (event.pointerId === pointerId) endDrag(false);
		});
		viewport.addEventListener('pointercancel', event => {
			if (event.pointerId === pointerId) endDrag(true);
		});

		// Autoplay pauses while the pointer or the keyboard focus is inside...
		carousel.addEventListener('pointerenter', stop);
		carousel.addEventListener('pointerleave', start);
		carousel.addEventListener('focusin', stop);
		carousel.addEventListener('focusout', start);

		// ...and while the carousel is scrolled off screen.
		const observer = new IntersectionObserver(entries => {
			for (const entry of entries) {
				if (entry.isIntersecting) start();
				else stop();
			}
		});
		observer.observe(carousel);

		paint(true);
		start();
	};

	document.addEventListener('astro:page-load', bindCarousel);
	bindCarousel();
</script>
