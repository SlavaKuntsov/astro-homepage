---
// The Resume's skills as grouped chips (ticket #8). The list is
// locale-independent (`SKILL_GROUPS`); only each group's label is translated, so
// the same component drops into the home page and the CV page (ticket #10)
// without duplicating the data.
import { SKILL_GROUPS } from '@/lib/skills';
import type { Translation } from '@/types/Translation';

interface Props {
	t: Translation;
}

const { t }: Props = Astro.props;
---

<section class='flex flex-col gap-5' data-skills-section>
	<h2 class='font-heading text-2xl font-semibold text-foreground'>
		{t.skills.heading}
	</h2>

	<div class='flex flex-col gap-4'>
		{
			SKILL_GROUPS.map(group => (
				<div
					class='flex flex-col gap-2'
					data-skill-group
					data-skill-group-id={group.id}
				>
					<h3 class='font-heading text-sm font-semibold uppercase tracking-wide text-muted-foreground'>
						{t.skills.groups[group.id]}
					</h3>
					<ul class='flex flex-wrap gap-2'>
						{group.skills.map(skill => (
							<li class='rounded-full border border-border bg-muted px-3 py-1 text-sm text-muted-foreground transition-colors'>
								{skill}
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</section>
