---
// The Arts gallery (ticket #10): the Artworks as a grid of "stickers" that
// opens a dependency-free lightbox. The markup is static and server-rendered; a
// small vanilla script (ADR-0002) drives a native `<dialog>` — which already
// makes the rest of the page inert and closes on Esc — and adds what it does
// not: wrapping Tab so focus cannot leave the dialog, closing on a backdrop
// click, stepping between Artworks (buttons, ←/→, or a swipe), and restoring
// focus to the thumbnail that opened it. Each opener is a real link to the
// image, so it works — and the artwork is viewable — without JavaScript.
//
// The grid opts into the Site-wide scroll reveal (`ScrollReveal`) with
// `data-reveal`; the shared mechanism fades the below-the-fold Artworks in.
//
// The Artworks are a grid of "stickers" wrapped in a paper panel.
import { Picture } from 'astro:assets';
import type { ArtworkEntry } from '@/lib/arts';
import { slugOfEntryId } from '@/lib/collection';
import type { Translation } from '@/types/Translation';
import StackChips from './StackChips.astro';

interface Props {
	/** The Artworks, already in authored order (see `orderedArts`). */
	arts: readonly ArtworkEntry[];
	t: Translation;
}

const { arts, t } = Astro.props;

/** A deterministic tilt per Artwork, so the grid reads as doodles on paper. */
const TILTS = [-1.6, 1.3, -0.9, 1.7, -1.2, 1];
const tiltFor = (index: number) => TILTS[index % TILTS.length];

const hasNavigation = arts.length > 1;
---

<div class='paper-grid mt-8 rounded-3xl border border-border p-4 sm:p-6'>
	<!--
		The wall of stickers is presentation, not text, and dragging across a
		card is how a scroll or a swipe starts: nothing here may be selected, or
		the selection would paint the Theme's `--accent` over the Artwork.
	-->
	<ul
		class='grid select-none grid-cols-2 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3'
		aria-label={t.arts.gallery}
		data-arts-gallery
		data-reveal
	>
		{
			arts.map((entry, index) => {
				const { data } = entry;
				const slug = slugOfEntryId(entry.id);

				return (
					<li class='art-item' data-art data-slug={slug}>
						<div
							class='art-sticker flex h-full flex-col gap-3 rounded-2xl border border-ink/15 p-3'
							style={`--tilt: ${tiltFor(index)}deg`}
						>
							<a
								href={data.image.src}
								class='art-opener group flex flex-col gap-3 rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 focus-visible:ring-offset-paper'
								data-art-open
							>
								<span class='overflow-hidden rounded-xl'>
									<Picture
										src={data.image}
										alt=''
										formats={['avif', 'webp']}
										quality='high'
										loading='lazy'
										pictureAttributes={{ class: 'contents' }}
										class='aspect-square w-full object-contain transition-transform duration-300 group-hover:scale-[1.04]'
										data-art-thumb
									/>
								</span>

								<span
									class='px-0.5 font-heading text-base font-semibold text-ink decoration-ink/50 underline-offset-4 group-hover:underline'
									data-art-title
								>
									{data.title}
								</span>
							</a>

							{data.tags !== undefined && data.tags.length > 0 && (
								<StackChips items={data.tags} label={t.arts.tags} />
							)}

							{data.link !== undefined && (
								<a
									href={data.link}
									target='_blank'
									rel='noopener noreferrer'
									class='relative z-10 w-fit text-sm font-medium text-ink underline decoration-ink/40 underline-offset-4 transition-colors hover:decoration-ink'
								>
									{t.arts.link} ↗
								</a>
							)}
						</div>
					</li>
				);
			})
		}
	</ul>
</div>

<!--
	One dialog for the whole gallery. Its content fills it, so a click on the
	::backdrop targets the dialog element itself while a click on the artwork
	does not — the pointer rule the script relies on.

	The dialog is only as wide as the Artwork it shows (`w-fit`), and the image
	is drawn at its own size (`w-auto`, not `w-full`): the line art is small, and
	stretching it is what made it look washed out. It still shrinks to fit a
	narrow viewport, and grows on its own if the Artwork is ever re-exported
	larger (#14).

	Nothing inside it is selectable (`select-none`): a drag — the start of a
	swipe — would otherwise select the Artwork, and a selection paints the
	Theme's `--accent`, a warm peach, over the whole picture, which reads as the
	Artwork turning yellow.
-->
<dialog
	class='arts-lightbox m-auto w-fit max-w-[min(92vw,36rem)] select-none overflow-hidden rounded-2xl border-0 bg-card p-0 text-foreground shadow-2xl backdrop:bg-overlay'
	aria-labelledby='arts-lightbox-caption'
	data-arts-lightbox
>
	<figure class='relative m-0'>
		<div
			class='art-paper relative flex touch-pan-y items-center justify-center'
			data-arts-lightbox-stage
		>
			<img
				alt=''
				width='350'
				height='350'
				draggable='false'
				class='block h-auto max-h-[70vh] w-auto max-w-full'
				data-arts-lightbox-image
			/>

			{
				hasNavigation && (
					<button
						type='button'
						class='absolute left-3 top-1/2 inline-flex size-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-border bg-card/90 text-foreground shadow-sm transition-colors hover:bg-muted'
						aria-label={t.arts.previous}
						data-arts-lightbox-previous
					>
						<svg
							viewBox='0 0 24 24'
							width='20'
							height='20'
							fill='none'
							stroke='currentColor'
							stroke-width='2'
							stroke-linecap='round'
							stroke-linejoin='round'
							aria-hidden='true'
						>
							<path d='M15 6l-6 6 6 6'></path>
						</svg>
					</button>
				)
			}

			{
				hasNavigation && (
					<button
						type='button'
						class='absolute right-3 top-1/2 inline-flex size-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-border bg-card/90 text-foreground shadow-sm transition-colors hover:bg-muted'
						aria-label={t.arts.next}
						data-arts-lightbox-next
					>
						<svg
							viewBox='0 0 24 24'
							width='20'
							height='20'
							fill='none'
							stroke='currentColor'
							stroke-width='2'
							stroke-linecap='round'
							stroke-linejoin='round'
							aria-hidden='true'
						>
							<path d='M9 6l6 6-6 6'></path>
						</svg>
					</button>
				)
			}

			<button
				type='button'
				class='absolute right-3 top-3 inline-flex size-9 cursor-pointer items-center justify-center rounded-full border border-border bg-card/90 text-foreground transition-colors hover:bg-muted'
				aria-label={t.arts.closeLightbox}
				data-arts-lightbox-close
			>
				<svg
					viewBox='0 0 24 24'
					width='18'
					height='18'
					fill='none'
					stroke='currentColor'
					stroke-width='2'
					stroke-linecap='round'
					aria-hidden='true'
				>
					<path d='M6 6l12 12M18 6L6 18'></path>
				</svg>
			</button>
		</div>

		<figcaption class='flex items-baseline justify-between gap-3 px-4 py-3'>
			<span
				id='arts-lightbox-caption'
				class='font-heading text-base font-semibold text-foreground'
				data-arts-lightbox-caption
			>
			</span>

			{
				hasNavigation && (
					<span
						class='shrink-0 tabular-nums text-sm text-muted-foreground'
						data-arts-lightbox-counter
					/>
				)
			}
		</figcaption>
	</figure>
</dialog>

<script>
	// The grid and the dialog are page content, so a client-side navigation
	// replaces them: bind the (new) elements each page load instead of holding a
	// reference. Binding is idempotent, so re-running the script is harmless.
	const GALLERY = '[data-arts-gallery]';
	const OPENER = '[data-art-open]';
	const TITLE = '[data-art-title]';
	const DIALOG = '[data-arts-lightbox]';
	const CLOSE = '[data-arts-lightbox-close]';
	const PREVIOUS = '[data-arts-lightbox-previous]';
	const NEXT = '[data-arts-lightbox-next]';
	const IMAGE = '[data-arts-lightbox-image]';
	const STAGE = '[data-arts-lightbox-stage]';
	const CAPTION = '[data-arts-lightbox-caption]';
	const COUNTER = '[data-arts-lightbox-counter]';
	const FOCUSABLE =
		'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

	/** A drag shorter than this is a click, not a swipe. */
	const SWIPE_THRESHOLD = 40;
	/** A click that moved further than this was a drag, so it is not a click. */
	const DRAG_SLOP = 8;
	/** Slack past the animation's own end before the fallback timer fires. */
	const SETTLE_GRACE = 50;

	/** The thumbnail that opened the lightbox, to focus when it closes. */
	let opener: HTMLElement | null = null;
	/** The position of the shown Artwork within the gallery. */
	let index = 0;
	/** True while the exit animation runs and `close()` is deferred. */
	let closing = false;
	/** Fallback timers, so a missed `animationend` can never wedge the dialog. */
	let openTimer: ReturnType<typeof setTimeout> | null = null;
	let closeTimer: ReturnType<typeof setTimeout> | null = null;
	/**
	 * The outgoing Artwork of a running crossfade. It is a snapshot layer over
	 * the canonical image, so the single `[data-arts-lightbox-image]` element —
	 * and everything that locates it — keeps its meaning.
	 */
	let outgoing: HTMLImageElement | null = null;
	let stepAnimations: Animation[] = [];
	/** Invalidates a crossfade that a newer step has superseded. */
	let stepToken = 0;

	const dialogEl = () => document.querySelector<HTMLDialogElement>(DIALOG);

	/** Every transition is instant under `prefers-reduced-motion: reduce`. */
	const prefersReducedMotion = () =>
		window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	/** Parses a CSS time (`220ms`, `0.22s`) into milliseconds. */
	const timeInMs = (value: string) => {
		const text = value.trim();
		const amount = Number.parseFloat(text);
		if (!Number.isFinite(amount) || amount <= 0) return 0;

		return text.endsWith('ms') || !text.endsWith('s') ? amount : amount * 1000;
	};

	/** The lightbox motion token in milliseconds; 0 when motion is reduced. */
	const motionDuration = (dialog: HTMLDialogElement) => {
		if (prefersReducedMotion()) return 0;

		const value = timeInMs(
			getComputedStyle(dialog).getPropertyValue('--motion-lightbox-duration')
		);

		return value > 0 ? value : 220;
	};

	const easingOf = (dialog: HTMLDialogElement) =>
		getComputedStyle(dialog)
			.getPropertyValue('--motion-lightbox-easing')
			.trim() || 'ease-out';

	/** Stops a running crossfade and discards its snapshot layer. */
	const clearStep = () => {
		stepToken++;
		for (const animation of stepAnimations) animation.cancel();
		stepAnimations = [];
		outgoing?.remove();
		outgoing = null;
	};

	/** Abandons any opening/closing animation and its fallback timer. */
	const settle = (dialog: HTMLDialogElement) => {
		if (openTimer !== null) clearTimeout(openTimer);
		if (closeTimer !== null) clearTimeout(closeTimer);
		openTimer = null;
		closeTimer = null;
		closing = false;
		delete dialog.dataset.lightboxState;
		for (const property of [
			'--lightbox-from-opacity',
			'--lightbox-from-scale',
			'--lightbox-backdrop-from-opacity'
		]) {
			dialog.style.removeProperty(property);
		}
	};

	/**
	 * Crossfades the canonical image from its current Artwork to `src` while
	 * keeping the old bitmap as an absolutely positioned snapshot. The new
	 * source is assigned synchronously — caption, counter, and `currentSrc` are
	 * in step the moment a step happens — and the fade waits for the new bitmap
	 * to decode, so a slow image never flashes blank.
	 */
	const crossfade = (
		dialog: HTMLDialogElement,
		image: HTMLImageElement,
		src: string
	) => {
		const duration = motionDuration(dialog);
		const previous = image.currentSrc || image.src;

		if (duration === 0 || previous === '' || previous === src) {
			clearStep();
			image.src = src;
			return;
		}

		clearStep();
		const token = stepToken;
		const stage = dialog.querySelector<HTMLElement>(STAGE);
		const rect = image.getBoundingClientRect();
		const stageRect = stage?.getBoundingClientRect();

		const ghost = document.createElement('img');
		ghost.alt = '';
		ghost.draggable = false;
		ghost.setAttribute('aria-hidden', 'true');
		ghost.className = image.className;
		ghost.src = previous;
		ghost.style.position = 'absolute';
		ghost.style.pointerEvents = 'none';
		ghost.style.margin = '0';
		if (stageRect) {
			ghost.style.left = `${rect.left - stageRect.left}px`;
			ghost.style.top = `${rect.top - stageRect.top}px`;
			ghost.style.width = `${rect.width}px`;
			ghost.style.height = `${rect.height}px`;
			ghost.style.maxWidth = 'none';
			ghost.style.maxHeight = 'none';
		}
		// Under the canonical image and its controls: the snapshot is a bitmap,
		// not a new top layer that would bury the arrows and close button.
		stage?.prepend(ghost);
		outgoing = ghost;

		image.src = src;

		const easing = easingOf(dialog);
		const start = () => {
			if (token !== stepToken) return;

			stepAnimations = [
				ghost.animate([{ opacity: 1 }, { opacity: 0 }], {
					duration,
					easing,
					fill: 'both'
				}),
				image.animate([{ opacity: 0 }, { opacity: 1 }], {
					duration,
					easing,
					fill: 'both'
				})
			];

			Promise.allSettled(stepAnimations.map(animation => animation.finished))
				.then(() => {
					if (token !== stepToken) return;
					for (const animation of stepAnimations) animation.cancel();
					stepAnimations = [];
					outgoing?.remove();
					outgoing = null;
				});
		};

		// The browser keeps the snapshot visible while the new bitmap decodes.
		image
			.decode()
			.catch(() => undefined)
			.then(start);
	};

	/** The gallery's openers, in display order — the lightbox's running order. */
	const openers = () =>
		Array.from(document.querySelectorAll<HTMLElement>(`${GALLERY} ${OPENER}`));

	/** Whether a click carried a modifier, so the browser should handle it. */
	const isModified = (event: MouseEvent) =>
		event.metaKey || event.ctrlKey || event.shiftKey || event.altKey;

	/**
	 * Paints one Artwork into the open lightbox: image, caption, counter. The
	 * caption and counter change immediately; only the image crossfades.
	 */
	const show = (trigger: HTMLElement, crossfadeImage = false) => {
		const dialog = dialogEl();
		if (!dialog) return;

		const list = openers();
		index = Math.max(list.indexOf(trigger), 0);

		const thumb = trigger.querySelector<HTMLImageElement>('img');
		const image = dialog.querySelector<HTMLImageElement>(IMAGE);
		const caption = dialog.querySelector<HTMLElement>(CAPTION);
		const counter = dialog.querySelector<HTMLElement>(COUNTER);
		const src = thumb ? thumb.currentSrc || thumb.src : '';

		if (image && src) {
			if (crossfadeImage) crossfade(dialog, image, src);
			else {
				clearStep();
				image.src = src;
			}
		}
		if (caption) {
			caption.textContent = trigger.querySelector(TITLE)?.textContent ?? '';
		}
		if (counter) counter.textContent = `${index + 1} / ${list.length}`;
	};

	/** Moves `delta` Artworks, wrapping around; leaves focus where it is. */
	const step = (delta: number) => {
		// While the exit runs the dialog is only still on screen to animate out;
		// stepping behind it would be a change the visitor never sees.
		if (closing) return;

		const list = openers();
		if (list.length < 2) return;

		index = (index + delta + list.length) % list.length;
		show(list[index], true);
	};

	/**
	 * Ends the close: releases the page exactly once, then lets the `close`
	 * handler restore focus. Idempotent, so the animation and its fallback
	 * timer may both reach it safely.
	 */
	const finishClose = () => {
		const dialog = dialogEl();
		if (!dialog) return;

		if (closeTimer !== null) clearTimeout(closeTimer);
		if (openTimer !== null) clearTimeout(openTimer);
		closeTimer = null;
		openTimer = null;
		closing = false;

		// Close while the exit state is still applied, so the dialog never
		// paints one frame back at full strength.
		if (dialog.open) dialog.close();
		delete dialog.dataset.lightboxState;
	};

	/** Starts the exit animation and defers `close()` until it settles. */
	const beginClose = () => {
		const dialog = dialogEl();
		if (!dialog || !dialog.open || closing) return;

		clearStep();
		const duration = motionDuration(dialog);
		if (duration === 0) {
			finishClose();
			return;
		}

		closing = true;

		// Freeze the current frame, so closing mid-enter reverses from where the
		// visitor actually is rather than snapping to full size first.
		const style = getComputedStyle(dialog);
		dialog.style.setProperty('--lightbox-from-opacity', style.opacity);
		dialog.style.setProperty(
			'--lightbox-from-scale',
			style.scale === 'none' ? '1' : style.scale
		);
		dialog.style.setProperty(
			'--lightbox-backdrop-from-opacity',
			getComputedStyle(dialog, '::backdrop').opacity
		);

		dialog.dataset.lightboxState = 'closing';
		closeTimer = setTimeout(finishClose, duration + SETTLE_GRACE);
	};

	const open = (trigger: HTMLElement) => {
		const dialog = dialogEl();
		if (!dialog) return;

		// Reopening during the exit keeps the same modal open: cancel the exit
		// instead of calling `showModal()` on an already-open dialog.
		if (dialog.open) {
			settle(dialog);
			show(trigger);
			opener = trigger;
			dialog.querySelector<HTMLElement>(CLOSE)?.focus();
			return;
		}

		clearStep();
		settle(dialog);
		show(trigger);
		opener = trigger;

		const duration = motionDuration(dialog);
		if (duration > 0) {
			dialog.dataset.lightboxState = 'opening';
			// The animation's own `animationend` usually clears this first.
			openTimer = setTimeout(() => {
				openTimer = null;
				if (dialog.dataset.lightboxState === 'opening') {
					delete dialog.dataset.lightboxState;
				}
			}, duration + SETTLE_GRACE);
		}

		dialog.showModal();
		dialog.querySelector<HTMLElement>(CLOSE)?.focus();
	};

	const bindDialog = () => {
		const dialog = dialogEl();
		if (!dialog || dialog.dataset.lightboxBound) return;

		dialog.dataset.lightboxBound = 'true';

		// Where the pointer went down, so a drag can be told from a click.
		let downX = 0;
		let downY = 0;
		let pointerDown = false;

		dialog.addEventListener('pointerdown', event => {
			pointerDown = true;
			downX = event.clientX;
			downY = event.clientY;
		});

		dialog.addEventListener('pointercancel', () => {
			pointerDown = false;
		});

		// A horizontal swipe moves between Artworks. It runs on pointerup, before
		// the click it may also raise — which the click handler then ignores.
		dialog.addEventListener('pointerup', event => {
			if (!pointerDown) return;
			pointerDown = false;

			const dx = event.clientX - downX;
			const dy = event.clientY - downY;
			if (Math.abs(dx) < SWIPE_THRESHOLD || Math.abs(dx) < Math.abs(dy)) return;

			step(dx < 0 ? 1 : -1);
		});

		dialog.addEventListener('click', event => {
			const target = event.target as Element | null;

			// A drag ended on the backdrop, not a click on it.
			const dragged =
				Math.abs(event.clientX - downX) > DRAG_SLOP ||
				Math.abs(event.clientY - downY) > DRAG_SLOP;
			if (dragged) return;

			if (target?.closest(CLOSE) || event.target === dialog) {
				beginClose();
			} else if (target?.closest(NEXT)) {
				step(1);
			} else if (target?.closest(PREVIOUS)) {
				step(-1);
			}
		});

		dialog.addEventListener('keydown', event => {
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				step(1);
				return;
			}
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				step(-1);
				return;
			}
			if (event.key !== 'Tab') return;

			// A modal dialog makes the rest of the page inert, but Tab still leaves
			// the dialog for the browser chrome past its last control: wrap Tab at
			// the ends so focus is genuinely trapped (spec user story 25).
			const focusable = Array.from(
				dialog.querySelectorAll<HTMLElement>(FOCUSABLE)
			).filter(element => element.offsetParent !== null);
			if (focusable.length === 0) return;

			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			const active = document.activeElement;

			// Only the two ends wrap; everywhere else the browser moves focus.
			if (active !== first && active !== last) return;

			event.preventDefault();
			(event.shiftKey ? last : first).focus();
		});

		// Esc is handled by the dialog itself, but its native close is immediate;
		// intercept the cancel so the dialog can animate out first.
		dialog.addEventListener('cancel', event => {
			event.preventDefault();
			beginClose();
		});

		// `animationend` also bubbles from the crossfade images and fires for the
		// `::backdrop`; only the dialog's own exit completes the close.
		dialog.addEventListener('animationend', event => {
			if (event.target !== dialog || event.pseudoElement !== '') return;
			if (dialog.dataset.lightboxState === 'closing') {
				finishClose();
			} else if (dialog.dataset.lightboxState === 'opening') {
				if (openTimer !== null) clearTimeout(openTimer);
				openTimer = null;
				delete dialog.dataset.lightboxState;
			}
		});

		// Either a finished exit or a close from elsewhere lands here: settle the
		// state and return the keyboard user to the thumbnail they opened. A
		// `close` queued just before a rapid reopen must not steal the new
		// session's focus or null its opener.
		dialog.addEventListener('close', () => {
			if (dialog.open) return;
			settle(dialog);
			clearStep();
			opener?.focus();
			opener = null;
		});
	};

	const bindGallery = () => {
		const gallery = document.querySelector<HTMLElement>(GALLERY);
		if (!gallery || gallery.dataset.lightboxBound) return;

		gallery.dataset.lightboxBound = 'true';
		gallery.addEventListener('click', event => {
			const target = event.target as Element | null;
			const trigger = target?.closest<HTMLElement>(OPENER);

			// Only a modifier-free click on a thumbnail opens the lightbox; the
			// artwork's own external link is not inside an opener, and a
			// modifier-click keeps its meaning (the opener's href is the image,
			// so it still works without JavaScript).
			if (!trigger) return;
			if (event instanceof MouseEvent && isModified(event)) return;

			event.preventDefault();
			open(trigger);
		});
	};

	const sync = () => {
		bindDialog();
		bindGallery();
	};

	document.addEventListener('astro:page-load', sync);
	sync();
</script>
