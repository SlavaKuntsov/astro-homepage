---
import { OWNER_NAME, SOCIAL_LINKS } from '@/consts';

const year = new Date().getFullYear();
---

<footer class='border-t border-border/70 bg-background' transition:persist>
	<div
		class='mx-auto flex w-full max-w-content flex-col gap-6 px-gutter py-10 text-sm sm:flex-row sm:items-center sm:justify-between'
	>
		<div class='space-y-1'>
			<p class='font-heading text-base font-semibold text-foreground'>
				{OWNER_NAME}
			</p>
			<p class='text-muted-foreground'>
				&copy; {year} &middot; Built with Astro
			</p>
		</div>

		<ul class='flex flex-wrap items-center gap-x-5 gap-y-2'>
			{
				SOCIAL_LINKS.map(link => (
					<li>
						<a
							href={link.href}
							target='_blank'
							rel='me noopener noreferrer'
							class='text-muted-foreground transition-colors hover:text-foreground'
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>
