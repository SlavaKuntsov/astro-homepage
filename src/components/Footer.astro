---
import { CONTACT_LINKS, contactLinkAttrs } from '@/lib/contacts';
import type { Translation } from '@/types/Translation';

interface Props {
	t: Translation;
	/** Persist keys are Locale-scoped so cross-Locale navigation re-renders. */
	persistKey: string;
}

const { t, persistKey }: Props = Astro.props;
const year = new Date().getFullYear();
---

<!--
	Persisted across View Transitions within a Locale. The key includes the
	Locale, so crossing Locales replaces the footer copy instead of keeping
	the previous Locale's text (ADR-0003).
-->
<footer
	class='border-t border-border/70 bg-background transition-colors'
	transition:persist={persistKey}
>
	<div
		class='mx-auto flex w-full max-w-content flex-col gap-6 px-gutter py-10 text-sm sm:flex-row sm:items-center sm:justify-between'
	>
		<div class='space-y-1'>
			<p
				class='font-heading text-base font-semibold text-foreground transition-colors'
			>
				{t.site.ownerName}
			</p>
			<p class='text-muted-foreground transition-colors'>
				&copy; {year} &middot; {t.footer.builtWithAstro}
			</p>
		</div>

		<ul class='flex flex-wrap items-center gap-x-5 gap-y-2'>
			{
				CONTACT_LINKS.map(contact => (
					<li>
						<a
							href={contact.href}
							{...contactLinkAttrs(contact)}
							class='text-muted-foreground transition-colors hover:text-foreground'
						>
							{t.contacts.labels[contact.kind]}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>
