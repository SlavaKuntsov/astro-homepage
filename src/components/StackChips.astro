---
// A Project's tag chips (the repo's topics, backstopped by the manual stack),
// rendered the same on the index card and the detail page so they cannot drift.
interface Props {
	items: string[];
	/** The localized accessible label (e.g. "Tags", "Теги"). */
	label: string;
}

const { items, label }: Props = Astro.props;
---

<ul class='flex flex-wrap gap-2' aria-label={label}>
	{
		items.map(item => (
			<li class='rounded-full border border-border bg-muted px-3 py-1 text-sm text-muted-foreground transition-colors'>
				{item}
			</li>
		))
	}
</ul>
