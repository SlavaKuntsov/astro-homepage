---
// A server-rendered Locale switcher (ADR-0005, spec user story 11): a plain
// link, no client JS, mapping the current path onto the same path in the
// other Locale. The prefix rule lives in `src/lib/i18n.ts`. The target Locale
// is carried on the element so the persisted header can re-derive the href
// after a client-side navigation.
import { localizePath } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';

interface Props {
	/** The Locale of the current page; the switcher leads to the other one. */
	lang: Locale;
	/** The current path (`Astro.url.pathname`) to map onto the other Locale. */
	pathname: string;
	/** An accessible label naming the Locale being switched to. */
	label: string;
}

const { lang, pathname, label } = Astro.props;

const target: Locale = lang === 'ru' ? 'en' : 'ru';
const href = localizePath(pathname, target);
---

<a
	href={href}
	hreflang={target}
	lang={target}
	aria-label={label}
	data-locale-switcher={target}
	class='inline-flex size-10 cursor-pointer items-center justify-center rounded-full bg-control font-heading text-sm font-semibold text-control-foreground transition-colors hover:bg-control/90'
>
	{target.toUpperCase()}
</a>
