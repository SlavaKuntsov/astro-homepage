---
// One Project as an index card, shared by the `/projects` index and the home
// page's featured block so the two cannot drift. The whole card is one link to
// `/projects/<slug>` — its accessible name is the title via `aria-labelledby`,
// so a click anywhere opens the Project. A card's tags are the repo's topics
// (the manual `stack` is the fallback) and a public Project whose repo was
// reached at build also shows its stars and primary language.
import StackChips from '@/components/StackChips.astro';
import { slugOfEntryId } from '@/lib/collection';
import type { ProjectMetadata } from '@/lib/enrichment';
import { localizePath } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import { coverImage, type ProjectEntry } from '@/lib/projects';
import type { Translation } from '@/types/Translation';

interface Props {
	entry: ProjectEntry;
	meta: ProjectMetadata;
	/** The Locale this card is rendered in. */
	lang: Locale;
	t: Translation;
}

const { entry, meta, lang, t }: Props = Astro.props;
const { data } = entry;
const slug = slugOfEntryId(entry.id);
const href = localizePath(`/projects/${slug}`, lang);
const cover = coverImage(data);
---

<li
	class='group flex flex-col overflow-hidden rounded-2xl border border-border bg-card transition-colors hover:border-primary has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-primary'
	data-project
	data-slug={slug}
	data-visibility={data.visibility}
	data-featured={data.featured === true}
	data-github-repo={data.githubRepo}
>
	<a
		href={href}
		aria-labelledby={`project-${slug}`}
		class='flex flex-1 flex-col focus-visible:outline-none'
	>
		{cover && (
			<img
				src={cover}
				alt=''
				width='640'
				height='360'
				loading='lazy'
				class='aspect-video w-full object-cover'
				data-project-cover
			/>
		)}

		<div class='flex flex-1 flex-col gap-4 p-5'>
			<h2
				id={`project-${slug}`}
				class='font-heading text-xl font-semibold text-foreground transition-colors group-hover:text-primary'
			>
				{data.title}
			</h2>

			{meta.description !== '' && (
				<p class='text-base text-muted-foreground'>{meta.description}</p>
			)}

			<StackChips items={meta.tags} label={t.projects.tags} />

			{(meta.stars !== null || meta.language !== null) && (
				<p class='flex flex-wrap items-center gap-3 text-sm text-muted-foreground'>
					{meta.stars !== null && (
						<span data-project-stars>
							<span aria-hidden='true'>★ </span>
							<span class='sr-only'>{t.projects.stars}: </span>
							{meta.stars}
						</span>
					)}
					{meta.language !== null && (
						<span data-project-language>{meta.language}</span>
					)}
				</p>
			)}

			<span class='mt-auto w-fit font-medium text-primary underline decoration-primary/40 underline-offset-4 transition-colors group-hover:decoration-primary'>
				{t.projects.viewProject}
			</span>
		</div>
	</a>
</li>
