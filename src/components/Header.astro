---
import { SITE_TITLE } from '@/consts';
import type { Translation } from '@/types/Translation';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	t: Translation;
}

const { t }: Props = Astro.props;

const links = [
	{ href: '/', label: t.header.links[0] },
	{ href: '/works', label: t.header.links[1] },
	{ href: '/arts', label: t.header.links[2] },
	{
		href: 'https://github.com/SlavaKuntsov/astro-homepage',
		label: t.header.links[3],
		external: true,
	},
];
---

<header
	class='sticky top-0 z-50 border-b border-border/70 bg-background/85 backdrop-blur-md'
	data-site-header
	transition:persist
>
	<div
		class='mx-auto flex h-16 w-full max-w-content items-center justify-between gap-4 px-gutter'
	>
		<a
			href='/'
			class='inline-flex items-center font-heading text-xl font-semibold tracking-tight text-foreground'
			aria-label={SITE_TITLE}
		>
			SK<span class='text-primary' aria-hidden='true'>.</span>
		</a>

		<nav aria-label='Primary' class='hidden items-center gap-1 md:flex'>
			{
				links.map(link => (
					<HeaderLink
						href={link.href}
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noreferrer' : undefined}
					>
						{link.label}
					</HeaderLink>
				))
			}
		</nav>

		<div class='flex items-center gap-2'>
			<!-- Filled by the server-rendered language switcher (#6). -->
			<div class='hidden md:block' data-language-switcher-slot></div>

			<ThemeToggle />

			<details class='relative md:hidden' data-mobile-menu>
				<summary
					class='inline-flex size-10 items-center justify-center rounded-full border border-border bg-card text-foreground transition-colors hover:bg-muted'
					aria-label='Open menu'
					data-mobile-menu-trigger
				>
					<svg
						viewBox='0 0 24 24'
						width='20'
						height='20'
						fill='none'
						stroke='currentColor'
						stroke-width='2'
						stroke-linecap='round'
						aria-hidden='true'
					>
						<path d='M4 7h16M4 12h16M4 17h16'></path>
					</svg>
				</summary>

				<div
					class='absolute right-0 top-full mt-3 w-64 rounded-2xl border border-border bg-card p-2 shadow-xl'
				>
					<nav aria-label='Mobile' class='flex flex-col gap-1'>
						{
							links.map(link => (
								<HeaderLink
									href={link.href}
									target={link.external ? '_blank' : undefined}
									rel={link.external ? 'noreferrer' : undefined}
									class='px-3 py-2.5'
								>
									{link.label}
								</HeaderLink>
							))
						}
					</nav>

					<!-- Same slot as the desktop switcher; #6 renders both. -->
					<div data-language-switcher-slot></div>
				</div>
			</details>
		</div>
	</div>
</header>

<script>
	import { isActivePath } from '@/lib/nav';

	const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
	const trigger = menu?.querySelector<HTMLElement>(
		'[data-mobile-menu-trigger]'
	);

	/** The persisted header does not re-render, so re-derive the active link. */
	const syncActiveLinks = () => {
		document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach(
			link => {
				const active = isActivePath(
					window.location.pathname,
					link.getAttribute('href') ?? ''
				);

				link.classList.toggle('is-active', active);
				if (active) {
					link.setAttribute('aria-current', 'page');
				} else {
					link.removeAttribute('aria-current');
				}
			}
		);
	};

	const syncMenuLabel = () => {
		trigger?.setAttribute('aria-label', menu?.open ? 'Close menu' : 'Open menu');
	};

	if (menu) {
		menu.addEventListener('toggle', syncMenuLabel);
		// A link tap is a navigation: do not leave the panel open behind it.
		menu.addEventListener('click', event => {
			if ((event.target as Element | null)?.closest('a')) menu.open = false;
		});

		document.addEventListener('keydown', event => {
			if (event.key !== 'Escape' || !menu.open) return;
			menu.open = false;
			trigger?.focus();
		});

		document.addEventListener('click', event => {
			if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
		});
	}

	document.addEventListener('astro:after-swap', () => {
		if (menu) menu.open = false;
		syncActiveLinks();
	});
	document.addEventListener('astro:page-load', syncActiveLinks);

	syncMenuLabel();
	syncActiveLinks();
</script>
