---
import { isActivePath } from '@/lib/nav';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const hrefValue = typeof href === 'string' ? href : (href?.toString() ?? '');
const active = isActivePath(Astro.url.pathname, hrefValue);
---

<a
	href={href}
	class:list={[
		'nav-link inline-flex items-center rounded-full px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground',
		className,
		{ 'is-active': active },
	]}
	data-nav-link
	aria-current={active ? 'page' : undefined}
	{...props}
>
	<slot />
</a>
