---
import type { Translation } from '@/types/Translation';

interface Props {
	t: Translation;
}

const { t }: Props = Astro.props;
---

<div
	class='transition-colors px-2 py-3 backdrop-blur-3xl bg-card/75 rounded-lg w-full'
>
	<p
		class='mx-auto w-full text-lg text-center whitespace-pre-wrap wrap-break-word'
		data-hero-pitch
		set:html={t.index.heading.greeting}
	/>
</div>
<div
	class='flex flex-col sm:flex-row items-center sm:items-start sm:justify-between gap-4 w-full'
>
	<div
		class='flex flex-col w-full sm:w-fit sm:h-full items-start gap-2 sm:gap-4'
	>
		<h1 class='font-bold text-[2.5rem] leading-11 tracking-wide'>
			{t.index.heading.name}
		</h1>
		<p class='text-xl' data-hero-position>{t.index.heading.position}</p>
	</div>
	<div
		class='rounded-full min-w-36 max-w-36 min-h-36 max-h-36 bg-muted bg-[url(/images/ava2.jpg)] bg-contain bg-center bg-no-repeat border-[3px] border-card transition-colors'
		data-avatar
	>
	</div>
</div>
