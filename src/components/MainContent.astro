---
import type { Translation } from '@/types/Translation';

interface Props {
	t: Translation;
}

const { t }: Props = Astro.props;
---

<div>
	<h2
		class='font-semibold text-2xl underline decoration-foreground decoration-1 underline-offset-3 mb-4 transition-colors'
	>
		{t.index.main.h_about}
	</h2>
	<p class='text-[1.3rem]/6.5 text-wrap'>
		{t.index.main.about}
	</p>
</div>
