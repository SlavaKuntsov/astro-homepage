---
// The home page's featured-Projects block (ticket #12): the collection-driven
// Projects whose frontmatter says `featured`, rendered with the same card the
// `/projects` index uses, plus a link to that index. The home page never
// hardcodes a Project — a featured one is a frontmatter edit.
import ProjectCard from '@/components/ProjectCard.astro';
import { enrichProjects } from '@/lib/enrichment';
import { localizePath } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import { featuredProjects, type ProjectEntry } from '@/lib/projects';
import type { Translation } from '@/types/Translation';

interface Props {
	/** All Projects in this Locale; the block picks the featured ones itself. */
	entries: readonly ProjectEntry[];
	lang: Locale;
	t: Translation;
}

const { entries, lang, t }: Props = Astro.props;
const featured = featuredProjects(entries);
const projects = await enrichProjects(featured);
const href = localizePath('/projects', lang);
---

{
	projects.length > 0 && (
		<section class='flex flex-col gap-5' data-featured-projects>
			<h2 class='font-heading text-2xl font-semibold text-foreground'>
				{t.projects.featuredHeading}
			</h2>

			<ul class='grid gap-6 sm:grid-cols-2' data-featured-list>
				{projects.map(({ entry, meta }) => (
					<ProjectCard entry={entry} meta={meta} lang={lang} t={t} />
				))}
			</ul>

			<a
				href={href}
				class='w-fit font-medium text-primary underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary'
			>
				{t.projects.viewAll}
			</a>
		</section>
	)
}
